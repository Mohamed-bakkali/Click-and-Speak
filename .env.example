# Environment Variables Template

# =============================================================================
# Groq API Configuration
# =============================================================================
# Required for speech-to-text and LLM processing in n8n workflows

# Your Groq API key (get it from https://console.groq.com/)
# Do not commit real secret values. This file is a template; copy to .env and fill with real values.
GROQ_API_KEY=gsk_your_groq_api_key_here


# =============================================================================
# GLPI Database Configuration
# =============================================================================
# MySQL connection parameters for GLPI

GLPI_DB_HOST=db
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=glpi123


# =============================================================================
# GLPI Service Configuration
# =============================================================================

GLPI_HOST=localhost
GLPI_PORT=8080
GLPI_INTERNAL_PORT=80


# =============================================================================
# n8n Configuration
# =============================================================================
# n8n is the workflow automation engine

# Port for n8n web interface
N8N_PORT=5678

# Encryption key for n8n credentials storage
# Generate a random 32-character string for production
# Keep the same value across restarts to preserve encrypted credentials
N8N_ENCRYPTION_KEY=your_32_character_encryption_key_here

# Database backend (sqlite for dev, postgres for production)
N8N_DB_TYPE=sqlite


# =============================================================================
# Grafana Configuration
# =============================================================================
# Grafana provides dashboards and visualization

# Admin password for Grafana
# Default username is 'admin'
GF_SECURITY_ADMIN_PASSWORD=admin

# Allow anonymous access as admin (dev only, set to false in production)
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Admin

# Disable basic authentication (demo mode, enable in production)
GF_AUTH_BASIC_ENABLED=false


# =============================================================================
# Monitoring Configuration
# =============================================================================

# Prometheus metrics retention period
PROMETHEUS_RETENTION=30d

# Loki log retention (days)
LOKI_RETENTION_DAYS=7


# =============================================================================
# Optional: Custom Configuration
# =============================================================================

# MySQL root password (for first-time setup)
MYSQL_ROOT_PASSWORD=your_root_password_here

# n8n database host (if using postgres)
N8N_DB_HOST=postgres
N8N_DB_PORT=5432
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=your_n8n_db_password

# =============================================================================
# Notes
# =============================================================================
# 
# 1. Copy this file to `.env`:
#    cp .env.example .env
#
# 2. Edit `.env` with your real values (do not commit `.env`)
#
# 3. `.env` is git-ignored for security
#
# 4. For production deployment:
#    - Use strong passwords (20+ characters, mixed case + numbers)
#    - Use external secrets management (Kubernetes, Vault, etc.)
#    - Enable HTTPS/TLS for all services
#    - Use non-default ports if possible
#    - Enable authentication on all services
#
# 5. Docker Compose automatically reads .env when running:
#    docker-compose up -d
#
